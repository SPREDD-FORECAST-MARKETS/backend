generator client {
  provider      = "prisma-client-js"
  output        = "../generated/prisma"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               Int               @id @default(autoincrement())
  username         String            @unique
  about            String
  wallet_address   String?           @unique
  role             Role              @default(USER)
  profile_pic      String?
  twitter_id       String?
  twitter_username String?
  twitter_name     String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  leaderboard      LeaderBoard[]
  markets          Market[]
  token_allocated  TokenAllocation[]
  trades           Trade[]
}

model Market {
  id                  Int                   @id @default(autoincrement())
  description         String                @default("")
  question            String
  expiry_date         DateTime
  image               String?
  createdAt           DateTime              @default(now())
  updatedAt           DateTime              @updatedAt
  creatorId           Int
  tags                String[]
  resolution_criteria String                @default("")
  outcomeWon          Int?
  status              EventStatus           @default(ACTIVE)
  contract_address    String                @default("")
  isResolved          Boolean?              @default(false)
  marketId            String                @default("")
  winningOutcome      String?
  creator             User                  @relation(fields: [creatorId], references: [id])
  marketPriceSnapshot MarketPriceSnapshot[]
  outcome             Outcome[]
  trades              Trade[]
}

model Outcome {
  id               Int               @id @default(autoincrement())
  outcome_title    String
  current_supply   Decimal           @default(0)
  total_liquidity  Decimal           @default(0)
  marketID         Int
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  market           Market            @relation(fields: [marketID], references: [id])
  tokenAllocations TokenAllocation[]
  trades           Trade[]
}

model TokenAllocation {
  id        Int      @id @default(autoincrement())
  amount    Decimal
  userId    Int
  outcomeId Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  outcome   Outcome  @relation(fields: [outcomeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([userId, outcomeId])
}

model Trade {
  id         Int       @id @default(autoincrement())
  unique_id  String    @default(uuid())
  order_type OrderType @default(BUY)
  order_size Decimal   @default(0)
  amount     Decimal   @default(0)
  afterPrice Decimal   @default(0)
  marketID   Int?
  outcomeId  Int?
  userID     Int?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  market     Market?   @relation(fields: [marketID], references: [id])
  outcome    Outcome?  @relation(fields: [outcomeId], references: [id])
  user       User?     @relation(fields: [userID], references: [id])
}

model LeaderBoard {
  id        Int       @id @default(autoincrement())
  userID    Int?
  pointType PointType
  points    Int       @default(0)
  user      User?     @relation(fields: [userID], references: [id])

  @@unique([userID, pointType])
}

model News {
  id          Int      @id @default(autoincrement())
  title       String
  description String
  source      String
  isRead      Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  image       String
}

model MarketPriceSnapshot {
  id          String   @id @default(uuid())
  timestamp   DateTime @default(now())
  noOdds      BigInt
  yesOdds     BigInt
  marketId    Int
  totalVolume BigInt
  market      Market   @relation(fields: [marketId], references: [id])

  @@index([timestamp])
  @@index([marketId, timestamp])
}

enum VoteType {
  YES
  NO
}

enum Role {
  ADMIN
  USER
  VOTERS
}

enum TokenType {
  ACCESS
  REFRESH
  RESET_PASSWORD
  VERIFY_EMAIL
}

enum EventStatus {
  ACTIVE
  EXPIRED
  CLOSED
}

enum EventOption {
  OPTION_A
  OPTION_B
}

enum OrderType {
  BUY
  SELL
}

enum PointType {
  CREATOR
  TRADER
}

model Creator {
  id                Int      @id @default(autoincrement())
  twitter_username  String   @unique
  twitter_name      String
  profile_image_url String
  position          Int      @unique
  joined_at         DateTime @default(now())
  created_at        DateTime @default(now())
  updated_at        DateTime @updatedAt
}

// Add these new models to your existing schema.prisma

model WeeklyLeaderboard {
  id          Int        @id @default(autoincrement())
  weekNumber  Int        @unique
  startTime   BigInt
  endTime     BigInt
  status      WeekStatus @default(ACTIVE)
  rewardPool  String     @default("0")
  txHash      String? // Transaction hash when submitted
  submittedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  // Relations
  traders  WeeklyTrader[]
  creators WeeklyCreator[]

  @@map("weekly_leaderboards")
}

model WeeklyTrader {
  id            Int      @id @default(autoincrement())
  weekNumber    Int
  walletAddress String
  fpPoints      String // Store as string to handle large BigInt values
  rank          Int      @default(0)
  isTopK        Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Relations
  weeklyLeaderboard WeeklyLeaderboard @relation(fields: [weekNumber], references: [weekNumber])

  @@unique([weekNumber, walletAddress])
  @@index([weekNumber, rank])
  @@index([walletAddress])
  @@map("weekly_traders")
}

model WeeklyCreator {
  id            Int      @id @default(autoincrement())
  weekNumber    Int
  walletAddress String
  fpPoints      String // Store as string to handle large BigInt values
  rank          Int?
  isTopK        Boolean  @default(false)
  createdAt     DateTime @default(now())

  // Relations
  weeklyLeaderboard WeeklyLeaderboard @relation(fields: [weekNumber], references: [weekNumber])

  @@unique([weekNumber, walletAddress])
  @@index([weekNumber, rank])
  @@index([walletAddress])
  @@map("weekly_creators")
}

// Add this enum
enum WeekStatus {
  ACTIVE
  PENDING_FINALIZE
  FINALIZED
}
